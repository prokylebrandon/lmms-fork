+# VST3 (experimental. Phase 0 decision: vendored, in-process. Target
+# platform is Windows per direct instruction -- see phase reports. The SDK
+# itself already supports Windows/macOS/Linux via separate module-loader
+# source files (module_win32.cpp/module_mac.mm/module_linux.cpp), so this
+# is gated on WANT_VST3 alone; src/CMakeLists.txt picks the right loader
+# file for whichever LMMS_BUILD_* is actually active. This also means the
+# Linux path stays live for compile-checking the platform-independent
+# logic even though Linux isn't the shipping target -- see phase report.)
+if(WANT_VST3)
+	set(LMMS_VST3_SDK_ROOT "${CMAKE_SOURCE_DIR}/src/3rdparty/vst3sdk")
+	if(EXISTS "${LMMS_VST3_SDK_ROOT}/CMakeLists.txt")
+		set(SMTG_ENABLE_VST3_PLUGIN_EXAMPLES OFF CACHE BOOL "" FORCE)
+		set(SMTG_ENABLE_VST3_HOSTING_EXAMPLES OFF CACHE BOOL "" FORCE)
+		set(SMTG_ENABLE_VSTGUI_SUPPORT OFF CACHE BOOL "" FORCE)
+		add_subdirectory("${LMMS_VST3_SDK_ROOT}" "${CMAKE_BINARY_DIR}/vst3sdk")
+		set(LMMS_HAVE_VST3 TRUE)
+		set(STATUS_VST3 "OK (experimental, in-process, target: Windows)")
+	else()
+		set(STATUS_VST3 "not found -- see src/3rdparty/vst3sdk (vendor per VENDOR_SDK.md)")
+	endif()
+else()
+	set(STATUS_VST3 "not built as requested")
+endif()
+
 IF(WANT_SUIL)
